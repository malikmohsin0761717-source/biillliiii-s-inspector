# Copy to .env only after reviewing costs and enabling a provider.
# OpenAI requests remain disabled by default until a key is explicitly saved.
# On Windows, use: npm run ai:key:set (hidden prompt; DPAPI CurrentUser encryption).
OPENAI_API_ENABLED=false
OPENAI_API_KEY=
# GPT-6 Luna is the default model. Each user-requested AI response may incur API charges.
OPENAI_MODEL=gpt-6-luna

# Optional Supabase configuration. Cloud sign-in does not unlock local workspace data.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
